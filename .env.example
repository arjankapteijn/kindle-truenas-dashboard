# Kopieer naar .env en vul in. .env staat in .gitignore — commit hem nooit.

# ── TrueNAS-verbinding (verplicht) ────────────────────────────────────────
# Websocket JSON-RPC-endpoint (`/api/current`).
#
# BELANGRIJK: TrueNAS trekt een API-key AUTOMATISCH in zodra die succesvol
# gebruikt wordt over een verbinding die de middleware niet als "secure
# transport" herkent (echte TLS, rechtstreeks naar TrueNAS' eigen HTTPS-
# poort) -- dit is een ingebouwde TrueNAS-beveiliging, geen bug hier. Een
# reverse proxy die zelf TLS termineert en er intern plain HTTP van maakt
# telt daar NIET voor, en TrueNAS' eigen UI-poort 8080 is standaard plain
# HTTP. Gebruik dus `wss://` rechtstreeks naar TrueNAS' EIGEN HTTPS-poort
# (System Settings > General > GUI -> "Web Interface HTTPS Port", vaak
# 8443) -- niet via een eigen nginx-proxy, en niet via de plain-HTTP-poort
# (vaak 8080).
KD_TRUENAS_URL=wss://172.16.0.1:8443/api/current
# TrueNAS' eigen HTTPS-poort gebruikt vaak een zelfondertekend certificaat
# -- zet dit op false (standaard) tenzij je daar een vertrouwd certificaat
# hebt ingesteld.
KD_TRUENAS_VERIFY_SSL=false
# Genereer via TrueNAS UI: gebruikersmenu (rechtsboven) > My API Keys >
# Add API Key. Overweeg een aparte, minder bevoorrechte gebruiker aan te
# maken specifiek voor deze key (een API-key erft de rechten van de
# gekoppelde gebruiker; er is geen aparte read-only scoping in de UI).
# Test een nieuwe key altijd EERST met een REST-curl (zie README) voordat
# je 'm hier zet, en gebruik 'm daarna niet nogmaals ergens anders -- een
# key die eenmaal over een onveilige transport is geprobeerd is al verbrand.
KD_TRUENAS_API_KEY=1-jouwApiKeyHier

# ── Weergave-instellingen (optioneel) ────────────────────────────────────
KD_TZ=Europe/Amsterdam
# Hoeveel actieve TrueNAS-alerts er maximaal bovenaan getoond worden.
KD_MAX_ALERTS=4

# ── Scheduler + server (optioneel) ───────────────────────────────────────
# Hoe vaak opnieuw ophalen/renderen. 300s (5 min) sluit aan op de Kindle-
# cronjob-cadans; disk-temperaturen worden door TrueNAS zelf sowieso niet
# vaker dan 1x/5 min ververst.
KD_POLL_INTERVAL_SECONDS=300
KD_DATA_DIR=/data
KD_HTTP_HOST=0.0.0.0
KD_HTTP_PORT=8000
# Meteen bij (her)start één keer renderen? Handig om een deploy te testen.
KD_RUN_ON_START=true
# Eén keer draaien en stoppen i.p.v. de scheduler+server (voor lokaal testen).
KD_RUN_ONCE=false
